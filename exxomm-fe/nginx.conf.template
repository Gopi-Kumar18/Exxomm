# exxomm-fe/nginx.conf.template (in the FE container)
#
# Serves the static SPA build and reverse-proxies /api to the backend tier,
# for local Docker Compose use (BACKEND_HOST=backend resolves there via
# Compose's embedded DNS). proxy_pass uses a variable, not a literal, so
# DNS resolution happens per-request instead of at nginx startup -- this
# lets nginx start cleanly in production too, where BACKEND_HOST doesn't
# resolve at all (the dedicated reverse-proxy EC2 routes /api straight to
# the backend before a request ever reaches this container, so this block
# is simply never hit there).

server {
  listen 80;
  resolver 127.0.0.11 valid=10s;

  root /usr/share/nginx/html;
  index index.html index.htm;

  location /api {
    set $backend_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_pass $backend_upstream;

    proxy_http_version 1.1;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_redirect off;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
