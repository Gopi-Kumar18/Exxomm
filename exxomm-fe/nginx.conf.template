# exxomm-fe/nginx.conf.template (in the FE container)
#
# Serves the static SPA build and reverse-proxies /api to the backend tier.
# BACKEND_HOST/BACKEND_PORT are substituted at container start by nginx's
# built-in envsubst-on-templates entrypoint (nginx:alpine >= 1.19), using
# values from the container's environment — never hardcoded here. In
# Docker Compose this resolves to the "backend" service name on
# frontend-tier; in other deployment targets it is overridden via env vars
# sourced from Jenkins credentials / AWS SSM.

server {
  listen 80;

  root /usr/share/nginx/html;
  index index.html index.htm;

  location /api {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};

    proxy_http_version 1.1;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_redirect off;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
