PORT=3000
JWT_SECRET=replace_with_a_long_random_jwt_secret

# Optional: only needed if MONGO_URI should override the discrete
# MONGO_USER/MONGO_PASS/MONGO_DB_NAME/MONGO_HOST vars below (e.g. pointing
# at a managed Mongo endpoint instead of the docker-compose "mongo" service).
# MONGO_URI=mongodb+srv://<atlas_db_user>:<atlas_db_password>@cluster0.j232n2.mongodb.net/?appName=Cluster0

# this root .env file is used by docker-compose.yml to pass environment variables to the containers
MONGO_USER=local_db_user
MONGO_PASS=localPass123
MONGO_DB_NAME=db_name
MONGO_HOST=mongo
MONGO_PORT=27017

# In production these values are never stored here — Jenkins injects them
# from AWS SSM Parameter Store as credentials/environment at deploy time.
