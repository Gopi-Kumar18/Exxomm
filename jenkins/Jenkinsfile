pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region (terraform var.aws_region)')
    string(name: 'JENKINS_ADMIN_CIDR', defaultValue: '49.205.115.168/32', description: 'terraform var.jenkins_admin_cidr -- your own IP for direct Jenkins UI access only. Does NOT need to be 0.0.0.0/0: GitHub webhook delivery reaches Jenkins through the reverse-proxy forwarding path instead, via a separate SG rule, so this stays restricted even on webhook-triggered builds that cannot override it interactively.')
    booleanParam(name: 'FORCE_ALL_STAGES', defaultValue: false, description: 'Run every stage regardless of changeset -- needed for the first build, or any build Jenkins has no changelog for (see Jenkinsfile comment above the Terraform stages)')
  }

  environment {
    IMAGE_TAG = "${env.BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    // Terraform stages only run when terraform-infra/ actually changed in
    // this commit (or FORCE_ALL_STAGES is set -- use that for the first
    // build, or any build Jenkins has no changelog for, per the project's
    // migration README). This keeps routine app-only commits from ever
    // touching infrastructure state. Every when-gated stage in this file
    // also runs on a jenkins/Jenkinsfile-only change -- a pipeline logic
    // edit could affect any stage, and a commit that changes nothing but
    // the Jenkinsfile must not silently report SUCCESS having run zero
    // actual stages (this happened once: see commit "Fix JENKINS_ADMIN_CIDR
    // default", build #10 -- every stage skipped, build still went green).
    stage('Terraform Format Check') {
      when { anyOf { changeset "terraform-infra/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          sh 'terraform fmt -check -recursive'
        }
      }
    }

    stage('Terraform Init') {
      when { anyOf { changeset "terraform-infra/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          sh 'terraform init -input=false'
        }
      }
    }

    stage('Terraform Validate') {
      when { anyOf { changeset "terraform-infra/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          sh 'terraform validate'
        }
      }
    }

    stage('Terraform Plan') {
      when { anyOf { changeset "terraform-infra/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          sh "terraform plan -input=false -var=\"jenkins_admin_cidr=${params.JENKINS_ADMIN_CIDR}\" -out=tfplan"
        }
      }
    }

    // Never auto-apply unreviewed infrastructure changes -- a human must
    // read the plan output above and approve it explicitly.
    stage('Approve Infrastructure Changes') {
      when { anyOf { changeset "terraform-infra/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          input message: 'Review the Terraform plan above before applying infrastructure changes.', ok: 'Approve'
        }
      }
    }

    stage('Terraform Apply') {
      when { anyOf { changeset "terraform-infra/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          sh 'terraform apply -input=false tfplan'
        }
      }
    }

    // Always runs, unconditionally -- every later stage needs these five
    // values, and they must never be hand-typed or hardcoded (an empty or
    // stale default here breaks every webhook-triggered build silently,
    // since an automatic trigger can't be prompted for parameters the way
    // "Build with Parameters" can -- this happened for real, see build
    // #11). Reading them straight from Terraform's own state instead means
    // they're always correct, even right after Terraform Apply replaces an
    // instance in this same run.
    stage('Read Infra Outputs') {
      steps {
        dir('terraform-infra') {
          sh 'terraform init -input=false'
          script {
            env.BACKEND_ECR_REPO     = sh(script: 'terraform output -raw backend_ecr_repository_url', returnStdout: true).trim()
            env.FRONTEND_ECR_REPO    = sh(script: 'terraform output -raw frontend_ecr_repository_url', returnStdout: true).trim()
            env.BACKEND_INSTANCE_ID  = sh(script: 'terraform output -raw backend_instance_id', returnStdout: true).trim()
            env.FRONTEND_INSTANCE_ID = sh(script: 'terraform output -raw frontend_instance_id', returnStdout: true).trim()
            env.REVERSE_PROXY_URL    = 'http://' + sh(script: 'terraform output -raw reverse_proxy_public_ip', returnStdout: true).trim()
          }
        }
      }
    }

    // No lint script exists in either app yet -- this confirms the lockfiles
    // actually install cleanly before spending time building/testing.
    stage('Validate') {
      when { anyOf { changeset "exxomm-be/**"; changeset "exxomm-fe/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      parallel {
        stage('Backend') {
          steps {
            dir('exxomm-be') {
              sh 'docker run --rm -v "$PWD":/app -w /app node:18-alpine npm install'
            }
          }
        }
        stage('Frontend') {
          steps {
            dir('exxomm-fe') {
              sh 'docker run --rm -v "$PWD":/app -w /app node:18-alpine npm install'
            }
          }
        }
      }
    }

    // Runs against source directly (not the production image, which has no
    // devDependencies) so a failing test never produces a pushed image.
    stage('Test') {
      when { anyOf { changeset "exxomm-be/**"; changeset "exxomm-fe/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      parallel {
        stage('Backend Tests') {
          steps {
            dir('exxomm-be') {
              sh 'docker run --rm -v "$PWD":/app -w /app node:18-alpine sh -c "npm install && npm test"'
            }
          }
        }
        stage('Frontend Tests') {
          steps {
            dir('exxomm-fe') {
              sh 'docker run --rm -v "$PWD":/app -w /app node:18-alpine sh -c "npm install && npm test"'
            }
          }
        }
      }
    }

    stage('ECR Login') {
      when { anyOf { changeset "exxomm-be/**"; changeset "exxomm-fe/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        sh "aws ecr get-login-password --region ${params.AWS_REGION} | docker login --username AWS --password-stdin ${env.BACKEND_ECR_REPO.split('/')[0]}"
      }
    }

    // Separate build/push per app so one image failing doesn't silently
    // leave the other half-deployed later.
    stage('Build & Push') {
      when { anyOf { changeset "exxomm-be/**"; changeset "exxomm-fe/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      parallel {
        stage('Backend Image') {
          steps {
            dir('exxomm-be') {
              sh """
                docker build -t ${env.BACKEND_ECR_REPO}:${IMAGE_TAG} -t ${env.BACKEND_ECR_REPO}:latest .
                docker push ${env.BACKEND_ECR_REPO}:${IMAGE_TAG}
                docker push ${env.BACKEND_ECR_REPO}:latest
              """
            }
          }
        }
        stage('Frontend Image') {
          steps {
            dir('exxomm-fe') {
              sh """
                docker build -t ${env.FRONTEND_ECR_REPO}:${IMAGE_TAG} -t ${env.FRONTEND_ECR_REPO}:latest .
                docker push ${env.FRONTEND_ECR_REPO}:${IMAGE_TAG}
                docker push ${env.FRONTEND_ECR_REPO}:latest
              """
            }
          }
        }
      }
    }

    // Deploys over AWS SSM Run Command -- no SSH/bastion. Each target
    // instance's own IAM role (not Jenkins) pulls from ECR and reads its
    // secrets from SSM Parameter Store.
    stage('Deploy') {
      when { anyOf { changeset "exxomm-be/**"; changeset "exxomm-fe/**"; changeset "jenkins/scripts/**"; changeset "jenkins/Jenkinsfile"; expression { params.FORCE_ALL_STAGES } } }
      parallel {
        stage('Deploy Backend') {
          steps {
            sh "bash jenkins/scripts/deploy-via-ssm.sh '${env.BACKEND_INSTANCE_ID}' jenkins/scripts/deploy-backend.sh '${env.BACKEND_ECR_REPO}:${IMAGE_TAG}' '${params.AWS_REGION}'"
          }
        }
        stage('Deploy Frontend') {
          steps {
            sh "bash jenkins/scripts/deploy-via-ssm.sh '${env.FRONTEND_INSTANCE_ID}' jenkins/scripts/deploy-frontend.sh '${env.FRONTEND_ECR_REPO}:${IMAGE_TAG}' '${params.AWS_REGION}'"
          }
        }
      }
    }

    // Also runs after an infra-only change (not just app changes) -- a
    // Terraform apply (e.g. a security-group rule) can affect reachability
    // just as much as a new app image can.
    stage('Health Check') {
      when {
        anyOf {
          changeset "exxomm-be/**"
          changeset "exxomm-fe/**"
          changeset "jenkins/scripts/**"
          changeset "terraform-infra/**"
          changeset "jenkins/Jenkinsfile"
          expression { params.FORCE_ALL_STAGES }
        }
      }
      steps {
        sh "bash jenkins/scripts/health-check.sh '${env.REVERSE_PROXY_URL}'"
      }
    }
  }

  post {
    success {
      echo "Deployed build ${IMAGE_TAG} and verified healthy."
    }
    failure {
      echo "Pipeline failed. :latest in ECR only moves after a successful push, so re-running Deploy with an older IMAGE_TAG rolls back manually if needed."
    }
    always {
      sh 'docker image prune -f || true'
    }
  }
}
