pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region (terraform var.aws_region)')
    string(name: 'BACKEND_ECR_REPO', defaultValue: '', description: 'terraform output backend_ecr_repository_url')
    string(name: 'FRONTEND_ECR_REPO', defaultValue: '', description: 'terraform output frontend_ecr_repository_url')
    string(name: 'BACKEND_INSTANCE_ID', defaultValue: '', description: 'terraform output backend_instance_id')
    string(name: 'FRONTEND_INSTANCE_ID', defaultValue: '', description: 'terraform output frontend_instance_id')
    string(name: 'REVERSE_PROXY_URL', defaultValue: '', description: 'http://<terraform output reverse_proxy_public_ip>')
    string(name: 'JENKINS_ADMIN_CIDR', defaultValue: '0.0.0.0/0', description: 'terraform var.jenkins_admin_cidr -- passed explicitly on every Terraform Plan so an omitted value never silently drifts the Jenkins SG back to the variable default')
    booleanParam(name: 'FORCE_ALL_STAGES', defaultValue: false, description: 'Run every stage regardless of changeset -- needed for the first build, or any build Jenkins has no changelog for (see Jenkinsfile comment above the Terraform stages)')
  }

  environment {
    IMAGE_TAG = "${env.BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    // Terraform stages only run when terraform-infra/ actually changed in
    // this commit (or FORCE_ALL_STAGES is set -- use that for the first
    // build, or any build Jenkins has no changelog for, per the project's
    // migration README). This keeps routine app-only commits from ever
    // touching infrastructure state.
    stage('Terraform Format Check') {
      when { anyOf { changeset "terraform-infra/**"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          sh 'terraform fmt -check -recursive'
        }
      }
    }

    stage('Terraform Init') {
      when { anyOf { changeset "terraform-infra/**"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          sh 'terraform init -input=false'
        }
      }
    }

    stage('Terraform Validate') {
      when { anyOf { changeset "terraform-infra/**"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          sh 'terraform validate'
        }
      }
    }

    stage('Terraform Plan') {
      when { anyOf { changeset "terraform-infra/**"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          sh "terraform plan -input=false -var=\"jenkins_admin_cidr=${params.JENKINS_ADMIN_CIDR}\" -out=tfplan"
        }
      }
    }

    // Never auto-apply unreviewed infrastructure changes -- a human must
    // read the plan output above and approve it explicitly.
    stage('Approve Infrastructure Changes') {
      when { anyOf { changeset "terraform-infra/**"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          input message: 'Review the Terraform plan above before applying infrastructure changes.', ok: 'Approve'
        }
      }
    }

    stage('Terraform Apply') {
      when { anyOf { changeset "terraform-infra/**"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        dir('terraform-infra') {
          sh 'terraform apply -input=false tfplan'
        }
      }
    }

    // No lint script exists in either app yet -- this confirms the lockfiles
    // actually install cleanly before spending time building/testing.
    stage('Validate') {
      when { anyOf { changeset "exxomm-be/**"; changeset "exxomm-fe/**"; expression { params.FORCE_ALL_STAGES } } }
      parallel {
        stage('Backend') {
          steps {
            dir('exxomm-be') {
              sh 'docker run --rm -v "$PWD":/app -w /app node:18-alpine npm install'
            }
          }
        }
        stage('Frontend') {
          steps {
            dir('exxomm-fe') {
              sh 'docker run --rm -v "$PWD":/app -w /app node:18-alpine npm install'
            }
          }
        }
      }
    }

    // Runs against source directly (not the production image, which has no
    // devDependencies) so a failing test never produces a pushed image.
    stage('Test') {
      when { anyOf { changeset "exxomm-be/**"; changeset "exxomm-fe/**"; expression { params.FORCE_ALL_STAGES } } }
      parallel {
        stage('Backend Tests') {
          steps {
            dir('exxomm-be') {
              sh 'docker run --rm -v "$PWD":/app -w /app node:18-alpine sh -c "npm install && npm test"'
            }
          }
        }
        stage('Frontend Tests') {
          steps {
            dir('exxomm-fe') {
              sh 'docker run --rm -v "$PWD":/app -w /app node:18-alpine sh -c "npm install && npm test"'
            }
          }
        }
      }
    }

    stage('ECR Login') {
      when { anyOf { changeset "exxomm-be/**"; changeset "exxomm-fe/**"; expression { params.FORCE_ALL_STAGES } } }
      steps {
        sh "aws ecr get-login-password --region ${params.AWS_REGION} | docker login --username AWS --password-stdin ${params.BACKEND_ECR_REPO.split('/')[0]}"
      }
    }

    // Separate build/push per app so one image failing doesn't silently
    // leave the other half-deployed later.
    stage('Build & Push') {
      when { anyOf { changeset "exxomm-be/**"; changeset "exxomm-fe/**"; expression { params.FORCE_ALL_STAGES } } }
      parallel {
        stage('Backend Image') {
          steps {
            dir('exxomm-be') {
              sh """
                docker build -t ${params.BACKEND_ECR_REPO}:${IMAGE_TAG} -t ${params.BACKEND_ECR_REPO}:latest .
                docker push ${params.BACKEND_ECR_REPO}:${IMAGE_TAG}
                docker push ${params.BACKEND_ECR_REPO}:latest
              """
            }
          }
        }
        stage('Frontend Image') {
          steps {
            dir('exxomm-fe') {
              sh """
                docker build -t ${params.FRONTEND_ECR_REPO}:${IMAGE_TAG} -t ${params.FRONTEND_ECR_REPO}:latest .
                docker push ${params.FRONTEND_ECR_REPO}:${IMAGE_TAG}
                docker push ${params.FRONTEND_ECR_REPO}:latest
              """
            }
          }
        }
      }
    }

    // Deploys over AWS SSM Run Command -- no SSH/bastion. Each target
    // instance's own IAM role (not Jenkins) pulls from ECR and reads its
    // secrets from SSM Parameter Store.
    stage('Deploy') {
      when { anyOf { changeset "exxomm-be/**"; changeset "exxomm-fe/**"; changeset "jenkins/scripts/**"; expression { params.FORCE_ALL_STAGES } } }
      parallel {
        stage('Deploy Backend') {
          steps {
            sh "bash jenkins/scripts/deploy-via-ssm.sh '${params.BACKEND_INSTANCE_ID}' jenkins/scripts/deploy-backend.sh '${params.BACKEND_ECR_REPO}:${IMAGE_TAG}' '${params.AWS_REGION}'"
          }
        }
        stage('Deploy Frontend') {
          steps {
            sh "bash jenkins/scripts/deploy-via-ssm.sh '${params.FRONTEND_INSTANCE_ID}' jenkins/scripts/deploy-frontend.sh '${params.FRONTEND_ECR_REPO}:${IMAGE_TAG}' '${params.AWS_REGION}'"
          }
        }
      }
    }

    // Also runs after an infra-only change (not just app changes) -- a
    // Terraform apply (e.g. a security-group rule) can affect reachability
    // just as much as a new app image can.
    stage('Health Check') {
      when {
        anyOf {
          changeset "exxomm-be/**"
          changeset "exxomm-fe/**"
          changeset "jenkins/scripts/**"
          changeset "terraform-infra/**"
          expression { params.FORCE_ALL_STAGES }
        }
      }
      steps {
        sh "bash jenkins/scripts/health-check.sh '${params.REVERSE_PROXY_URL}'"
      }
    }
  }

  post {
    success {
      echo "Deployed build ${IMAGE_TAG} and verified healthy."
    }
    failure {
      echo "Pipeline failed. :latest in ECR only moves after a successful push, so re-running Deploy with an older IMAGE_TAG rolls back manually if needed."
    }
    always {
      sh 'docker image prune -f || true'
    }
  }
}
